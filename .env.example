# --- Chat assistant -----------------------------------------------------
LLM_PROVIDER=offline            # offline | openai_compat
# For openai_compat (examples; check each provider's current free-tier limits):
#   Ollama (local, free):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama
#   Other OpenAI-compatible hosts: set their base URL, model name and key
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# --- API ----------------------------------------------------------------
API_KEY=                         # if set, every /assistant call needs header X-API-Key
CORS_ORIGINS=http://localhost:8501
API_URL=http://localhost:8000    # used by the Streamlit client
HEART_DB=                        # optional path to the SQLite file (default data/app.db)
